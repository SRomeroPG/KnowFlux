{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/dispute.schema.json",
  "type": "object",
  "allOf": [ { "$ref": "common.schema.json#/$defs/entityBase" }, { "$ref": "common.schema.json#/$defs/authoredRootNames" } ],
  "required": ["id", "disputes", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^DSP-[0-9]{4,}$" },
    "type": { "const": "dispute" },
    "disputes": { "type": "object", "required": ["entity"], "properties": {
      "entity": { "$ref": "common.schema.json#/$defs/entityId" },
      "facet": { "type": "string", "pattern": "^(?:specified(?:@v[0-9]+|\\[[A-Za-z0-9_=;,-]+\\])?|observed:[^\\s#]+)$" }
    }, "if": { "required": ["facet"], "properties": { "facet": {} } }, "then": { "properties": { "entity": { "type": "string", "pattern": "^(BP|BR|DE)-[0-9]{4,}$" } } }, "additionalProperties": false },
    "raised_by": { "$ref": "common.schema.json#/$defs/authority" },
    "claim": { "type": "string" },
    "counter_evidence": { "type": "array", "items": { "type": "string", "pattern": "^EV-[0-9]{4,}$" } },
    "status": { "enum": ["open", "resolved"] },
    "resolution": { "type": "object", "properties": {
      "kind": { "enum": ["knowledge-changed", "evidence-rejected", "scope-clarified"] },
      "change": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" }
    }, "additionalProperties": true }
  },
  "propertyNames": { "not": { "enum": ["specified", "observed", "facet"] } },
  "unevaluatedProperties": false
}
