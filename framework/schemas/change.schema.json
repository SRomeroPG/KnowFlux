{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/change.schema.json",
  "type": "object",
  "allOf": [ { "$ref": "common.schema.json#/$defs/entityBase" }, { "$ref": "common.schema.json#/$defs/authoredRootNames" } ],
  "required": ["id", "decided_at", "type", "affects"],
  "properties": {
    "id": { "type": "string", "pattern": "^CHG-[0-9]{4,}$" },
    "type": { "enum": ["ADD", "MODIFY", "CLARIFY", "DEPRECATE", "REMOVE", "RENAME", "SPLIT", "MERGE"] },
    "decided_at": { "type": "string", "format": "date" },
    "effective_from": { "type": "string", "format": "date" },
    "impact_classes": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "documentation", "behavioral", "data-contract", "integration", "presentation", "security", "architecture"] } },
    "affects": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["facet"], "properties": {
      "facet": { "$ref": "common.schema.json#/$defs/specifiedAddress" },
      "previous_version": { "type": "integer", "minimum": 1 },
      "new_version": { "type": "integer", "minimum": 1 }
    }, "additionalProperties": false } },
    "reason": { "type": "string" },
    "authority": { "$ref": "common.schema.json#/$defs/authority" },
    "evidence": { "type": "array", "items": { "type": "string", "pattern": "^EV-[0-9]{4,}$" } },
    "changed_fields": { "type": "array", "items": { "type": "object", "required": ["path", "from", "to"], "properties": {
      "path": { "type": "string" }, "from": {}, "to": {}
    }, "additionalProperties": false } },
    "requires_revalidation": { "type": "array", "items": { "type": "string", "pattern": "^SC-[0-9]{4,}$" } },
    "resolves": { "type": "array", "items": { "type": "string", "pattern": "^DSP-[0-9]{4,}$" } }
  },
  "propertyNames": { "not": { "enum": ["specified", "observed", "facet"] } },
  "unevaluatedProperties": false
}
