{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/business-rule.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    { "$ref": "common.schema.json#/$defs/authoredRootNames" }
  ],
  "required": ["id", "type", "identity"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/brId" },
    "type": { "const": "business-rule" },
    "identity": {
      "type": "object",
      "required": ["rule_kind", "subject", "determination", "governs"],
      "properties": {
        "rule_kind": { "enum": ["invariant", "decision", "derivation", "eligibility", "authorization"] },
        "subject": { "type": "string", "minLength": 1 },
        "determination": { "type": "string", "minLength": 1 },
        "governs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^DE-[0-9]{4,}(?:\\.[A-Za-z_][A-Za-z0-9_-]*)?$" } },
        "produces": { "$ref": "common.schema.json#/$defs/outIds" },
        "signature": { "type": "object", "required": ["algorithm", "value"], "properties": {
          "algorithm": { "type": "string", "pattern": "^kf-normalize-v[0-9]+$" },
          "value": { "type": "string" }
        }, "additionalProperties": false },
        "distinct_because": { "type": "string" }
      },
      "additionalProperties": false
    },
    "specified": {
      "oneOf": [
        { "$ref": "business-rule-specified.schema.json" },
        { "type": "array", "minItems": 1, "items": { "$ref": "business-rule-specified.schema.json" } }
      ]
    }
  },
  "unevaluatedProperties": false
}
