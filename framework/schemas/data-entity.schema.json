{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/data-entity.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    { "$ref": "common.schema.json#/$defs/authoredRootNames" }
  ],
  "required": ["id", "type"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/deId" },
    "type": { "const": "data-entity" },
    "identity": { "type": "object", "additionalProperties": false },
    "contains": { "$ref": "common.schema.json#/$defs/deIds" },
    "specified": {
      "oneOf": [
        { "$ref": "data-entity-specified.schema.json" },
        { "type": "array", "minItems": 1, "items": { "$ref": "data-entity-specified.schema.json" } }
      ]
    }
  },
  "unevaluatedProperties": false
}
