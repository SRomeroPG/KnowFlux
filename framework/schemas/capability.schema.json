{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/capability.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    { "$ref": "common.schema.json#/$defs/authoredRootNames" }
  ],
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "pattern": "^CAP-[0-9]{4,}$" },
    "type": { "const": "capability" }
  },
  "unevaluatedProperties": false
}
