{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/capability.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    { "$ref": "common.schema.json#/$defs/authoredRootNames" }
  ],
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "pattern": "^CAP-[0-9]{4,}$" },
    "type": { "const": "capability" }
  },
  "propertyNames": { "not": { "enum": ["specified", "observed", "facet", "truth_state", "logic", "evidence", "part_of", "executes", "reads", "writes", "produces", "calls", "triggered_by", "performed_by", "transitions", "governs", "overrides", "contains", "exercises", "covers", "supports", "blocks", "affects", "disputes"] } }
}
