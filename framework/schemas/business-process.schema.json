{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowflux.dev/schemas/business-process.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/entityBase" },
    { "$ref": "common.schema.json#/$defs/authoredRootNames" }
  ],
  "required": ["id", "type", "part_of"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/bpId" },
    "type": { "const": "business-process" },
    "part_of": { "$ref": "common.schema.json#/$defs/capId" },
    "identity": { "type": "object", "additionalProperties": false },
    "specified": {
      "oneOf": [
        { "$ref": "business-process-specified.schema.json" },
        { "type": "array", "minItems": 1, "items": { "$ref": "business-process-specified.schema.json" } }
      ]
    }
  },
  "unevaluatedProperties": false
}
